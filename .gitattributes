# Auto detect text files and perform LF normalization
* text=auto

# Line endings that must not depend on the platform or on core.autocrlf:
# git apply needs the patches as LF (Dolphin's sources are LF), and sh scripts break with CRLF.
*.patch text eol=lf
*.sh text eol=lf
# cmd.exe can misread batch files with LF line endings.
*.bat text eol=crlf
# Vendored shaders stay byte for byte as upstream's on every checkout (tools/crt/slang-shaders/MANIFEST).
tools/crt/slang-shaders/** -text
# And the GLSL librashader-cli writes from them, which vendor_chain.py check compares byte for byte.
tools/crt/blender-chain/** -text
